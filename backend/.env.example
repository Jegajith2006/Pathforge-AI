# Database configuration (SQLite default, can be switched to PostgreSQL)
DATABASE_URL=sqlite:///./data/pathforge.db

# JWT & Authentication Secret
SECRET_KEY=pathforge_ai_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS & Frontend URL
FRONTEND_URL=http://localhost:5173

# Optional: Gemini API Key for generative insights & explanations
GEMINI_API_KEY=

# Storage paths
UPLOAD_DIR=./uploads
DATA_DIR=./data
DATASET_DIR=../datasets

# Email & SMTP Service (for OTP verification and password recovery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@pathforge.ai
SMTP_USE_TLS=true
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
